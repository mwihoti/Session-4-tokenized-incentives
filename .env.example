# Copy this file to .env and fill in your own values. Never commit .env.
# cp .env.example .env

# TEST-ONLY key, funded with Fuji AVAX from the Builders Hub faucet.
# Never use a key that has held or will hold real funds.
PRIVATE_KEY=

# Avalanche Fuji testnet RPC endpoint (default shown; override if you use your own node).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# The Session 4 decision: your marketing budget, in whole tokens with 18 decimals.
# Budget your fulfilment FIRST, then set this. It is immutable after deploy.
# Example below = 10,000,000 tokens.
EMISSION_CAP=10000000000000000000000000
